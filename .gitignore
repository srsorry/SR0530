# ==========================================
# 1. 操作系统级自动生成文件
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ==========================================
# 2. CFG: Excel 和 Office 临时文件
# (保留你自己写的配置表，但忽略打开时产生的隐藏锁文件)
# ==========================================
# ~$*.xls
# ~$*.xlsx
# ~$*.csv
~$*.doc
~$*.docx
~$*.ppt
~$*.pptx
*.tmp

# ==========================================
# 3. py: Python 与 PyCharm 相关
# ==========================================
# 忽略 Python 编译的字节码文件
__pycache__/
*.py[cod]
*$py.class
# 忽略 PyCharm 本地工程配置 (极其重要，防冲突)
.idea/
.vscode/
# 忽略可能存在的虚拟环境
venv/
env/
.env
orgData/
genData/
# ==========================================
# 4. matlab: MATLAB 相关
# ==========================================
# 忽略 MATLAB 自动保存文件和崩溃日志
*.asv
matlab_crash_dump*
# 忽略编译产生的二进制文件 (如果以后用到)
*.mexw64
*.mexa64
*.slxc
slprj/

# ==========================================
# 5. sim: ModelSim / 仿真相关 (重灾区)
# ==========================================
# 忽略 ModelSim 默认的编译库文件夹
work/
# 忽略波形文件 (体积通常巨大，千万别传)
*.wlf
*.vcd
*.fsdb
# 忽略仿真日志文件
transcript
*.log
# 忽略一些其他的中间文件
modelsim.ini
*.mti
wlft*

# ==========================================
# 6. RTL: 纯净的硬件代码区
# ==========================================
# RTL 目录下通常只放 .v 或 .sv 源码，一般不需要忽略什么。
# 但如果习惯在代码旁边直接综合，可以忽略综合网表 (视情况取消注释)
# *.edif
# *.ngc